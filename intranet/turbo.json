{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "POSTGRES_DB",
    "POSTGRES_HOST",
    "POSTGRES_PASSWORD",
    "POSTGRES_PORT",
    "POSTGRES_USER",
    "GRAPH_SERVICE_URL",
    "CUSTOMER_SERVICE_URL",
    "DOCUMENT_SERVICE_URL",
    "GRAPH_SERVICE_PORT",
    "CUSTOMER_SERVICE_PORT",
    "DOCUMENT_SERVICE_PORT",
    "ENTRA_TENANT_ID",
    "ENTRA_CLIENT_ID",
    "ENTRA_CLIENT_SECRET",
    "ENTRA_REDIRECT_URI",
    "ENTRA_POST_LOGOUT_REDIRECT_URI",
    "NEXT_PUBLIC_ENTRA_CLIENT_ID",
    "NEXT_PUBLIC_ENTRA_TENANT_ID",
    "NEXT_PUBLIC_ENTRA_CALLBACK_PATH",
    "NEXT_PUBLIC_GRAPH_SERVICE_URL",
    "NEXT_PUBLIC_CUSTOMER_SERVICE_URL",
    "NEXT_PUBLIC_DOCUMENT_SERVICE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**", "coverage/**", "!.next/cache/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    }
  }
}
