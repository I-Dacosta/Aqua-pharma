{
  "name": "@platform/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "dotenv -e ../../.env -- prisma generate && tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prisma:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev --name init --skip-generate",
    "prisma:migrate:reset": "dotenv -e ../../.env -- prisma migrate reset --force --skip-generate",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "test": "node -e \"console.log('No tests configured for db')\""
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.17.1",
    "typescript": "^5.9.3"
  }
}
